---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(product, {
	siteTitle: "Hack Night Bakery",
	siteUrl: Astro.url.origin,
	path: `/products/${slug}`,
});
const price = product.data.price?.toFixed(2) ?? "—";
const cats = product.data.terms?.category ?? [];
---

<Base title={seo.title} description={seo.description} content={{ collection: "products", id: product.data.id, slug }}>
	<article class="product">
		{product.data.featured_image ? (
			<div class="image" {...product.edit.featured_image}>
				<Image image={product.data.featured_image} alt={product.data.featured_image.alt ?? product.data.title} />
			</div>
		) : (
			<div class="image placeholder" aria-hidden="true"></div>
		)}
		<div class="info">
			{cats.length > 0 && (
				<p class="cats">{cats.map((c) => <a href={`/products?category=${c.slug}`}>{c.label}</a>)}</p>
			)}
			<h1 {...product.edit.title}>{product.data.title}</h1>
			<p class="price">${price} <span class="unit">/ {product.data.unit ?? "ea"}</span></p>
			{product.data.summary && <p class="summary" {...product.edit.summary}>{product.data.summary}</p>}
			{product.data.description && <div class="desc"><PortableText value={product.data.description} /></div>}
			<div class="actions">
				{product.data.available === false ? (
					<span class="soldout">Currently sold out — check back soon.</span>
				) : (
					<a class="btn" href={`/order?product=${product.id}`}>Add to order →</a>
				)}
			</div>
		</div>
	</article>
</Base>

<style>
	.product { display: grid; gap: 2rem; grid-template-columns: 1fr; }
	@media (min-width: 720px) { .product { grid-template-columns: 1fr 1fr; } }
	.image :global(img) { width: 100%; border-radius: var(--radius); display: block; }
	.image.placeholder { aspect-ratio: 4/3; background: var(--bg-alt); border-radius: var(--radius); }
	.cats { display: flex; gap: 0.5rem; margin: 0 0 0.5rem; font-size: 0.85rem; }
	.cats a { color: var(--accent); }
	h1 { margin: 0 0 0.25rem; }
	.price { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.75rem; }
	.unit { color: var(--muted); font-weight: 400; font-size: 1rem; }
	.summary { color: var(--muted); margin: 0 0 1rem; }
	.desc { margin: 0 0 1.5rem; }
	.actions { margin-top: 0.5rem; }
	.btn {
		display: inline-block;
		padding: 0.65rem 1.4rem;
		border-radius: 999px;
		font-weight: 600;
		background: var(--accent);
		color: #fff;
	}
	.btn:hover { text-decoration: none; opacity: 0.92; }
	.soldout { color: var(--muted); font-style: italic; }
</style>
